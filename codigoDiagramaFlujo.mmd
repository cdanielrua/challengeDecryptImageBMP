flowchart TD
    A[Inicio] --> B[Cargar imágenes BMP<br/>I_O.bmp → pixelData<br/>I_M.bmp → pixelImData<br/>M.bmp → pixelMascaraData]
    B --> C[Reservar buffers<br/>pixelDataTransform<br/>pixelDataMask]
    C --> D[Cargar primer txt<br/>loadSeedMasking semilla y n_pixels]
    D --> E[Inicializar<br/>j = 0<br/>numero_verificaciones = 0<br/>verificado = true]
    E --> F{j &lt;= 7}
    F -- Si --> G[applyTransformation]
    G --> H[applyMask]
    H --> I{verifyMaskedData?}
    I -- true --> J[numero_verificaciones += 1<br/>exportImage<br/>copiar transform a original<br/>j = -1<br/>liberar maskingData<br/>loadSeedMasking siguiente txt]
    J --> F
    I -- false --> K[j += 1]
    K --> F
    F -- No --> L[Liberar memoria<br/>pixelData<br/>pixelImData<br/>pixelMascaraData<br/>pixelDataTransform<br/>pixelDataMask<br/>maskingData]
    L --> M[Fin]
