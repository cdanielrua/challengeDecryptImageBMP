flowchart TD
  %% Inicio
  A([Start]) 
    --> B[Initialize: i = 0, Current = I_D]

  %% Bucle principal: i < n ?
  B --> C{ i < n ? }
  C -- No --> D[Output Current as I₀] --> E([End])

  %% Antes de probar transformaciones, inicializar índice j
  C -- Yes --> F[Set j = 0]

  %% Bucle interno: probar cada transformación
  subgraph InnerLoop ["Inner loop: try transformations"]
    direction TB
    F --> G{ j ≤ 7 ? }
    G -- No --> H[Error: no valid transformation] --> E

    G -- Yes --> I[Choose transformation T₍ⱼ₎]
    I --> J[Apply T₍ⱼ₎ to Current → P]
    J --> K[Compute M_check = P + M]
    K --> L{ M_check valid? }
    L -- Yes --> M[Accept P: Current = P, i = i + 1] --> C
    L -- No --> N[Increment j: j = j + 1] --> G
  end
